# Cerebrum Blocks - Environment Variables
# Copy this file to .env and fill in your values

# ===============================
# AI Provider Keys
# ===============================
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ===============================
# Security
# ===============================
# Master key for admin/server-side use only. NEVER ship this in the frontend
# bundle — it grants unlimited tier access. Rotate via Render env if ever leaked.
CEREBRUM_MASTER_KEY=your_strong_random_master_key_here

# Per-user/standard API keys. Issue separate keys per consumer (frontend, CI,
# integrations). Each gets a 1000 req/hr rate limit.
# CEREBRUM_API_KEY_FRONTEND=cb_<random>
# CEREBRUM_API_KEY_CI=cb_<random>

# Frontend build-time vars live in frontend/.env (see frontend/.env.example):
#   VITE_API_BASE   - backend URL
#   VITE_API_KEY    - client-safe key (do NOT use the master key here)

# Comma-separated list of allowed CORS origins (no spaces)
# Leave empty to use safe defaults
CORS_ORIGINS=https://your-domain.com,https://your-app.onrender.com

# ===============================
# Storage
# ===============================
# Directory for uploaded files and persistent data
DATA_DIR=./data

# ===============================
# API Configuration
# ===============================
# Public base URL for generated file links
API_BASE_URL=https://your-api.onrender.com

# Max upload size in bytes (default: 10MB)
MAX_UPLOAD_SIZE=10485760

# ===============================
# Deployment
# ===============================
ENV=production
PORT=8000

# ===============================
# Sandbox Runner (Track B Phase 4)
# ===============================
# URL of the out-of-process sandbox runner service used for blocks with
# elevated capabilities (network, filesystem, privileged imports).
# Default: http://localhost:8001
SANDBOX_RUNNER_URL=http://localhost:8001

# ===============================
# Logging & Error Tracking
# ===============================
# DEBUG | INFO | WARNING | ERROR (default: INFO)
LOG_LEVEL=INFO
# json | text (default: json in prod, text in dev)
LOG_FORMAT=json
# Optional. When set, errors are forwarded to Sentry. Requires sentry-sdk.
SENTRY_DSN=
# 0.0–1.0; only meaningful with SENTRY_DSN set
SENTRY_TRACES_SAMPLE_RATE=0.0
# Optional commit SHA, surfaced in Sentry as release tag
RELEASE_SHA=

# ===============================
# Telegram Bot
# ===============================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ===============================
# Evidence Vault
# ===============================
EVIDENCE_VAULT_PATH=/tmp/cerebrum_evidence_vault.json

# ===============================
# ML / Learning Engine Storage
# ===============================
LEARNING_ENGINE_STORAGE=/tmp/cerebrum_learning_engine.json
