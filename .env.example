# Cerebrum Blocks - Environment Variables
# Copy this file to .env and fill in your values

# ===============================
# AI Provider Key — Kimi (Moonshot) only
# ===============================
# Copy values from your password manager (Bitwarden/1Password).
# Kimi is the platform's single LLM provider (OpenAI-compatible cloud API).
KIMI_API_KEY=
# Optional overrides:
# KIMI_BASE_URL=https://api.moonshot.ai/v1
# KIMI_MODEL=kimi-k2-0905-preview

# ===============================
# Security
# ===============================
# Master key for admin/server-side use only. NEVER ship this in the frontend
# bundle — it grants unlimited tier access. Generate a strong random value in
# your password manager and paste it into Render/GitHub/Cloudflare env vars.
CEREBRUM_MASTER_KEY=

# Per-user/standard API keys. Issue separate keys per consumer (frontend, CI,
# integrations). Each gets a 1000 req/hr rate limit.
# CEREBRUM_API_KEY_FRONTEND=
# CEREBRUM_API_KEY_CI=

# Frontend build-time vars live in frontend/.env (see frontend/.env.example):
#   VITE_API_BASE   - backend URL
#   VITE_API_KEY    - client-safe key (do NOT use the master key here)

# Comma-separated list of allowed CORS origins (no spaces)
# Leave empty to use safe defaults
CORS_ORIGINS=https://your-domain.com,https://your-app.onrender.com

# ===============================
# Storage
# ===============================
# Directory for uploaded files and persistent data
DATA_DIR=./data

# ===============================
# API Configuration
# ===============================
# Public base URL for generated file links
API_BASE_URL=https://your-api.onrender.com

# Max upload size in bytes (default: 10MB)
MAX_UPLOAD_SIZE=10485760

# ===============================
# Deployment
# ===============================
ENV=production
PORT=8000

# ===============================
# Sandbox Runner (Track B Phase 4)
# ===============================
# URL of the out-of-process sandbox runner service used for blocks with
# elevated capabilities (network, filesystem, privileged imports).
# Default: http://localhost:8001
SANDBOX_RUNNER_URL=http://localhost:8001

# ===============================
# Logging & Error Tracking
# ===============================
# DEBUG | INFO | WARNING | ERROR (default: INFO)
LOG_LEVEL=INFO
# json | text (default: json in prod, text in dev)
LOG_FORMAT=json
# Optional. When set, errors are forwarded to Sentry. Requires sentry-sdk.
SENTRY_DSN=
# 0.0–1.0; only meaningful with SENTRY_DSN set
SENTRY_TRACES_SAMPLE_RATE=0.0
# never | small | medium | always (sentry-sdk 2.x). Default "never": the SDK
# does not attach request bodies at all. POST /v1/execute bodies carry
# plaintext secret material for block="secrets"/"config"/"auth", so raise
# this only if you understand what you are shipping to a third party.
# The before_send scrubber in app/core/logging_config.py runs regardless.
SENTRY_MAX_REQUEST_BODY_SIZE=never
# Truncation cap (characters) applied to any request body that still gets
# through the scrubber.
SENTRY_MAX_BODY_CHARS=2048
# Optional commit SHA, surfaced in Sentry as release tag
RELEASE_SHA=

# Seconds to cache the Kimi CLI capability probe used by
# /v1/system/diagnostics. The probe spawns a subprocess; it is never run
# from the liveness or readiness path.
KIMI_PROBE_TTL_SECONDS=300

# ===============================
# Nightly in-process backups (app/core/backup_scheduler.py)
# ===============================
# Runs inside the web service: Render cron jobs cannot mount persistent
# disks, so this process is the only one that can snapshot DATA_DIR.
# Archives land in DATA_DIR/backups (override with BACKUP_DIR); the last
# run's report is surfaced at /v1/system/diagnostics under last_backup.
# 04:00 UTC by default — offset from CerebrumDev's 03:00 on purpose.
BACKUP_SCHEDULE_ENABLED=1
BACKUP_UTC_HOUR=4
BACKUP_KEEP=14
# BACKUP_DIR=

# ===============================
# Evidence Vault
# ===============================
EVIDENCE_VAULT_PATH=/tmp/cerebrum_evidence_vault.json

# ===============================
# ML / Learning Engine Storage
# ===============================
LEARNING_ENGINE_STORAGE=/tmp/cerebrum_learning_engine.json
