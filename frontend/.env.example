# Frontend build-time environment (Vite)
# Copy to .env.local for local dev; configure in Render dashboard for prod.

# Backend API base URL. Defaults: http://localhost:8000 on localhost,
# https://cerebrum-platform-api.onrender.com otherwise.
VITE_API_BASE=

# Bearer key sent on every API call. SPAs cannot keep secrets — this key is
# visible in the production JS bundle. Issue a CLIENT-SAFE key (scoped, rate-
# limited) here, NOT the master key. Rotate by updating this env var and
# redeploying the frontend.
VITE_API_KEY=
