{
  "id": "insurance",
  "name": "Insurance & Risk Suite",
  "version": "1.0.0",
  "description": "Insurance & Risk Suite: typed document analysis, entity extraction, metrics, compliance checks, and risk scoring for the insurance domain.",
  "status": "available",
  "author": "bopoadz-del",
  "tags": [
    "domain",
    "container",
    "insurance"
  ],
  "source": {
    "repo": "https://github.com/bopoadz-del/Cerebrum-Blocks",
    "ref": "main",
    "publish_script": "scripts/publish_kit.py"
  },
  "container": {
    "class": "app.containers.insurance.InsuranceContainer",
    "default_chat_prompt": null
  },
  "blocks": [
    "pdf",
    "ocr",
    "chat",
    "image",
    "insurance_v2"
  ],
  "prompts": [],
  "data": [],
  "core_modules": [
    "app/core/insurance_knowledge.py",
    "app/core/insurance_types.py",
    "app/core/confidence.py",
    "app/core/schema_registry.py"
  ],
  "artifacts": [
    {
      "src": "app/containers/insurance.py",
      "dest": "app/containers/insurance.py"
    },
    {
      "src": "app/blocks/insurance_v2.py",
      "dest": "app/blocks/insurance_v2.py"
    },
    {
      "src": "app/core/insurance_knowledge.py",
      "dest": "app/core/insurance_knowledge.py"
    },
    {
      "src": "app/core/insurance_types.py",
      "dest": "app/core/insurance_types.py"
    },
    {
      "src": "app/core/confidence.py",
      "dest": "app/core/confidence.py"
    },
    {
      "src": "app/core/schema_registry.py",
      "dest": "app/core/schema_registry.py"
    }
  ],
  "price_cents": 0,
  "install_requires": {
    "min_platform_version": "2.0.0",
    "python": ">=3.10"
  }
}
