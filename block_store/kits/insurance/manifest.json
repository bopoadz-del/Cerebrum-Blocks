{
  "id": "insurance",
  "name": "Insurance & Risk Suite",
  "version": "1.0.0",
  "description": "Insurance & Risk Suite: typed document analysis, entity extraction, metrics, compliance checks, and risk scoring for the insurance domain.",
  "status": "available",
  "author": "bopoadz-del",
  "tags": [
    "domain",
    "container",
    "insurance"
