{
  "id": "finance",
  "name": "Finance & Investment Suite",
  "version": "1.0.0",
  "description": "Finance & Investment Suite: typed document analysis, entity extraction, metrics, compliance checks, and risk scoring for the finance domain.",
  "status": "available",
  "author": "bopoadz-del",
  "tags": [
    "domain",
    "container",
    "finance"
  ],
  "source": {
    "repo": "https://github.com/bopoadz-del/Cerebrum-Blocks",
    "ref": "main",
    "publish_script": "scripts/publish_kit.py"
  },
  "container": {
    "class": "app.containers.finance.FinanceContainer",
    "default_chat_prompt": null
  },
  "blocks": [
    "pdf",
    "ocr",
    "chat",
    "image",
    "finance_v2"
  ],
  "prompts": [],
  "data": [],
  "core_modules": [
    "app/core/finance_knowledge.py",
    "app/core/finance_types.py",
    "app/core/confidence.py",
    "app/core/schema_registry.py",
    "app/core/domain_block_v2.py",
    "app/core/metric_utils.py",
    "app/core/typed_block.py",
    "app/containers/base.py"
  ],
  "artifacts": [
    {
      "src": "app/containers/finance.py",
      "dest": "app/containers/finance.py"
    },
    {
      "src": "app/blocks/finance_v2.py",
      "dest": "app/blocks/finance_v2.py"
    },
    {
      "src": "app/core/finance_knowledge.py",
      "dest": "app/core/finance_knowledge.py"
    },
    {
      "src": "app/core/finance_types.py",
      "dest": "app/core/finance_types.py"
    },
    {
      "src": "app/core/confidence.py",
      "dest": "app/core/confidence.py"
    },
    {
      "src": "app/core/schema_registry.py",
      "dest": "app/core/schema_registry.py"
    },
    {
      "src": "app/core/domain_block_v2.py",
      "dest": "app/core/domain_block_v2.py"
    },
    {
      "src": "app/core/metric_utils.py",
      "dest": "app/core/metric_utils.py"
    },
    {
      "src": "app/core/typed_block.py",
      "dest": "app/core/typed_block.py"
    },
    {
      "src": "app/containers/base.py",
      "dest": "app/containers/base.py"
    }
  ],
  "price_cents": 0,
  "install_requires": {
    "min_platform_version": "2.0.0",
    "python": ">=3.10"
  }
}
