{
  "id": "event_bus",
  "name": "Event Bus",
  "version": "1.0.0",
  "author": "Cerebrum Team",
  "description": "Event bus for synchronous and asynchronous block communication",
  "layer": 5,
  "requires": [
    "memory"
  ],
  "inputs": [
    {
      "name": "input",
      "type": "json",
      "required": false,
      "description": "{\"topic\": \"chat.response\", \"payload\": {}}"
    },
    {
      "name": "action",
      "type": "string",
      "required": false,
      "description": "Action",
      "default": "publish",
      "options": [
        "publish",
        "subscribe",
        "request",
        "respond",
        "get_topology"
      ]
    },
    {
      "name": "default_timeout",
      "type": "number",
      "required": false,
      "description": "Default Timeout",
      "default": 30
    },
    {
      "name": "max_pending",
      "type": "number",
      "required": false,
      "description": "Max Pending",
      "default": 1000
    }
  ],
  "outputs": [
    {
      "name": "status",
      "type": "text",
      "description": "Status"
    },
    {
      "name": "topic",
      "type": "text",
      "description": "Topic"
    },
    {
      "name": "correlation_id",
      "type": "text",
      "description": "Correlation ID"
    },
    {
      "name": "delivered",
      "type": "number",
      "description": "Delivered"
    }
  ],
  "execution": {
    "type": "docker",
    "image": "ghcr.io/cerebrum-blocks/event_bus:latest"
  },
  "ui_schema": [
    {
      "name": "input",
      "widget": "json",
      "label": "{\"topic\": \"chat.response\", \"payload\": {}}"
    },
    {
      "name": "action",
      "widget": "select",
      "label": "Action",
      "options": [
        "publish",
        "subscribe",
        "request",
        "respond",
        "get_topology"
      ]
    },
    {
      "name": "default_timeout",
      "widget": "number",
      "label": "Default Timeout"
    },
    {
      "name": "max_pending",
      "widget": "number",
      "label": "Max Pending"
    }
  ],
  "tags": [
    "interface",
    "messaging",
    "events",
    "core"
  ]
}