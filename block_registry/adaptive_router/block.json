{
  "id": "adaptive_router",
  "name": "Adaptive Router",
  "version": "1.0.0",
  "author": "Cerebrum Team",
  "description": "",
  "layer": 2,
  "requires": [
    "analytics",
    "monitoring",
    "failover"
  ],
  "inputs": [
    {
      "name": "input",
      "type": "json",
      "required": false,
      "description": "Task, quality tier, budget, provider constraints..."
    },
    {
      "name": "action",
      "type": "string",
      "required": false,
      "description": "Action",
      "default": "select_provider",
      "options": [
        "select_provider",
        "record_result",
        "get_recommendation",
        "forecast_issues",
        "get_scores",
        "reset_scores",
        "ab_test",
        "explain_choice"
      ]
    },
    {
      "name": "learning_enabled",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Configuration parameter: learning_enabled"
    },
    {
      "name": "history_window",
      "type": "number",
      "required": false,
      "default": 100,
      "description": "Configuration parameter: history_window"
    },
    {
      "name": "exploration_rate",
      "type": "number",
      "required": false,
      "default": 0.1,
      "description": "Configuration parameter: exploration_rate"
    },
    {
      "name": "min_samples",
      "type": "number",
      "required": false,
      "default": 10,
      "description": "Configuration parameter: min_samples"
    },
    {
      "name": "time_aware",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Configuration parameter: time_aware"
    },
    {
      "name": "quality_threshold",
      "type": "number",
      "required": false,
      "default": 0.8,
      "description": "Configuration parameter: quality_threshold"
    }
  ],
  "outputs": [
    {
      "name": "result",
      "type": "json",
      "description": "Result"
    }
  ],
  "execution": {
    "type": "docker",
    "image": "ghcr.io/cerebrum-blocks/adaptive_router:latest"
  },
  "ui_schema": [
    {
      "name": "input",
      "widget": "json",
      "label": "Task, quality tier, budget, provider constraints..."
    },
    {
      "name": "action",
      "widget": "select",
      "label": "Action",
      "options": [
        "select_provider",
        "record_result",
        "get_recommendation",
        "forecast_issues",
        "get_scores",
        "reset_scores",
        "ab_test",
        "explain_choice"
      ]
    },
    {
      "name": "learning_enabled",
      "widget": "toggle",
      "label": "Learning Enabled"
    },
    {
      "name": "history_window",
      "widget": "number",
      "label": "History Window"
    },
    {
      "name": "exploration_rate",
      "widget": "number",
      "label": "Exploration Rate"
    },
    {
      "name": "min_samples",
      "widget": "number",
      "label": "Min Samples"
    },
    {
      "name": "time_aware",
      "widget": "toggle",
      "label": "Time Aware"
    },
    {
      "name": "quality_threshold",
      "widget": "number",
      "label": "Quality Threshold"
    }
  ],
  "tags": [
    "ai",
    "optimization",
    "smart",
    "routing"
  ]
}
