{
  "id": "dashboard",
  "name": "Dashboard",
  "version": "1.0.0",
  "author": "Cerebrum Team",
  "description": "",
  "layer": 3,
  "requires": [
    "auth",
    "monitoring"
  ],
  "inputs": [
    {
      "name": "input",
      "type": "json",
      "required": false,
      "description": "JSON payload for the selected action"
    },
    {
      "name": "action",
      "type": "string",
      "required": false,
      "description": "Action",
      "default": "render",
      "options": [
        "render",
        "add_widget",
        "remove_widget",
        "update_widget",
        "get_metrics",
        "list_widgets",
        "save_layout",
        "get_layout",
        "subscribe_stream",
        "get_snapshot"
      ]
    },
    {
      "name": "default_layout",
      "type": "string",
      "required": false,
      "default": "grid",
      "description": "Configuration parameter: default_layout"
    },
    {
      "name": "refresh_interval",
      "type": "number",
      "required": false,
      "default": 30,
      "description": "Configuration parameter: refresh_interval"
    },
    {
      "name": "max_widgets",
      "type": "number",
      "required": false,
      "default": 20,
      "description": "Configuration parameter: max_widgets"
    },
    {
      "name": "theme",
      "type": "string",
      "required": false,
      "default": "light",
      "description": "Configuration parameter: theme"
    }
  ],
  "outputs": [
    {
      "name": "result",
      "type": "json",
      "description": "Result"
    }
  ],
  "execution": {
    "type": "docker",
    "image": "ghcr.io/cerebrum-blocks/dashboard:latest"
  },
  "ui_schema": [
    {
      "name": "input",
      "widget": "json",
      "label": "JSON payload for the selected action"
    },
    {
      "name": "action",
      "widget": "select",
      "label": "Action",
      "options": [
        "render",
        "add_widget",
        "remove_widget",
        "update_widget",
        "get_metrics",
        "list_widgets",
        "save_layout",
        "get_layout",
        "subscribe_stream",
        "get_snapshot"
      ]
    },
    {
      "name": "default_layout",
      "widget": "text",
      "label": "Default Layout"
    },
    {
      "name": "refresh_interval",
      "widget": "number",
      "label": "Refresh Interval"
    },
    {
      "name": "max_widgets",
      "widget": "number",
      "label": "Max Widgets"
    },
    {
      "name": "theme",
      "widget": "text",
      "label": "Theme"
    }
  ],
  "tags": [
    "ui",
    "platform",
    "dashboard",
    "domain"
  ]
}
