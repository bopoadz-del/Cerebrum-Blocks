{
  "id": "vector",
  "name": "Vector",
  "version": "1.0.0",
  "author": "Cerebrum Team",
  "description": "",
  "layer": 3,
  "requires": [
    "config",
    "memory"
  ],
  "inputs": [
    {
      "name": "input",
      "type": "json",
      "required": false,
      "description": "Vector id, embedding, or query"
    },
    {
      "name": "action",
      "type": "string",
      "required": false,
      "description": "Action",
      "default": "add",
      "options": [
        "add",
        "search",
        "delete",
        "get",
        "count"
      ]
    },
    {
      "name": "backend",
      "type": "string",
      "required": false,
      "default": "chroma",
      "description": "Configuration parameter: backend"
    },
    {
      "name": "embedding_model",
      "type": "string",
      "required": false,
      "default": "all-MiniLM-L6-v2",
      "description": "Configuration parameter: embedding_model"
    },
    {
      "name": "collection",
      "type": "string",
      "required": false,
      "default": "default",
      "description": "Configuration parameter: collection"
    },
    {
      "name": "persist_directory",
      "type": "string",
      "required": false,
      "default": "./data/vector",
      "description": "Configuration parameter: persist_directory"
    }
  ],
  "outputs": [
    {
      "name": "result",
      "type": "json",
      "description": "Result"
    }
  ],
  "execution": {
    "type": "docker",
    "image": "ghcr.io/cerebrum-blocks/vector:latest"
  },
  "ui_schema": [
    {
      "name": "input",
      "widget": "json",
      "label": "Vector id, embedding, or query"
    },
    {
      "name": "action",
      "widget": "select",
      "label": "Action",
      "options": [
        "add",
        "search",
        "delete",
        "get",
        "count"
      ]
    },
    {
      "name": "backend",
      "widget": "text",
      "label": "Backend"
    },
    {
      "name": "embedding_model",
      "widget": "text",
      "label": "Embedding Model"
    },
    {
      "name": "collection",
      "widget": "text",
      "label": "Collection"
    },
    {
      "name": "persist_directory",
      "widget": "text",
      "label": "Persist Directory"
    }
  ],
  "tags": [
    "ai",
    "vector",
    "search",
    "core"
  ]
}