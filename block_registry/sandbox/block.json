{
  "id": "sandbox",
  "version": "1.0.0",
  "description": "Secure code execution isolation with memory limits, CPU limits, and sandbox policies",
  "tags": [
    "security",
    "isolation",
    "sandbox",
    "enterprise"
  ],
  "layer": 1,
  "requires": [
    "memory",
    "config"
  ],
  "execution": {
    "type": "docker",
    "image": "ghcr.io/cerebrum-blocks/sandbox:latest"
  },
  "ui_schema": [
    {
      "name": "action",
      "widget": "select",
      "label": "Action"
    },
    {
      "name": "code",
      "widget": "textarea",
      "label": "Code to execute"
    },
    {
      "name": "language",
      "widget": "select",
      "label": "Language"
    },
    {
      "name": "policy",
      "widget": "text",
      "label": "Policy"
    }
  ],
  "default_config": {
    "default_level": "strict",
    "max_memory_mb": 512,
    "max_cpu_time": 5,
    "network_allowed": false,
    "filesystem_readonly": true,
    "allowed_modules": [
      "math",
      "random",
      "datetime",
      "json",
      "re",
      "string",
      "collections"
    ],
    "auto_kill": true
  },
  "name": "Sandbox",
  "author": "Cerebrum Team",
  "inputs": [
    {
      "name": "action",
      "type": "string",
      "required": false,
      "description": "Sandbox action"
    },
    {
      "name": "code",
      "type": "string",
      "required": false,
      "description": "Code to execute"
    },
    {
      "name": "language",
      "type": "string",
      "required": false,
      "default": "python",
      "description": "Execution language"
    },
    {
      "name": "policy",
      "type": "string",
      "required": false,
      "default": "default",
      "description": "Sandbox policy name"
    }
  ],
  "outputs": [
    {
      "name": "result",
      "type": "json",
      "description": "Execution result"
    },
    {
      "name": "stdout",
      "type": "string",
      "description": "Captured stdout"
    }
  ]
}
