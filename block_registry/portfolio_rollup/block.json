{
  "author": "Cerebrum Team",
  "description": "Aggregates property records ({id, value, status}) into total value, count, and per-status groupings; empty input yields honest zeros.",
  "id": "portfolio_rollup",
  "inputs": [
    {
      "name": "action",
      "type": "string",
      "required": false,
      "default": "aggregate",
      "options": [
        "aggregate"
      ],
      "description": "aggregate"
    },
    {
      "name": "properties",
      "type": "json",
      "required": true,
      "description": "[{id, value, status}] property records"
    }
  ],
  "layer": 3,
  "name": "Portfolio Rollup",
  "outputs": [
    {
      "name": "result",
      "type": "json",
      "description": "Capability result"
    }
  ],
  "permissions": {
    "blocks": [],
    "filesystem": false,
    "imports": [],
    "network": false
  },
  "publisher_id": "cerebrum_platform",
  "requires": [],
  "tags": [
    "estate",
    "private_estate_operations",
    "steward"
  ],
  "trust_tier": "platform",
  "ui_schema": [
    {
      "label": "Action",
      "name": "action",
      "options": [
        "aggregate"
      ],
      "widget": "select"
    },
    {
      "label": "Properties",
      "name": "properties",
      "widget": "json"
    }
  ],
  "version": "1.0.0",
  "execution": {
    "type": "python",
    "entrypoint": "block.py"
  },
  "reads": [
    {
      "kind": "caller",
      "scope": "input"
    },
    {
      "kind": "config",
      "scope": "runtime"
    }
  ],
  "writes": [
    {
      "kind": "caller",
      "scope": "output"
    }
  ],
  "never": [],
  "acceptance": [
    {
      "id": "invalid_records",
      "check": "errors when records carry non-numeric values, reporting the invalid records",
      "status": "failed"
    },
    {
      "id": "missing_properties",
      "check": "refuses or errors when properties is absent or not a list",
      "status": "refused"
    },
    {
      "id": "unknown_action",
      "check": "errors on an unknown or missing action",
      "status": "failed"
    }
  ]
}
