{
  "id": "rate_limiter",
  "name": "Rate Limiter",
  "version": "1.0.0",
  "author": "Cerebrum Team",
  "description": "",
  "layer": 1,
  "requires": [
    "memory",
    "database"
  ],
  "inputs": [
    {
      "name": "input",
      "type": "json",
      "required": false,
      "description": "JSON payload for the selected action"
    },
    {
      "name": "action",
      "type": "string",
      "required": false,
      "description": "Action",
      "default": "check_limit",
      "options": [
        "check_limit",
        "record_hit",
        "set_custom_limit",
        "get_usage_stats",
        "reset_limit",
        "get_limit_info"
      ]
    },
    {
      "name": "strategy",
      "type": "string",
      "required": false,
      "default": "sliding_window",
      "description": "Configuration parameter: strategy"
    },
    {
      "name": "default_limit",
      "type": "number",
      "required": false,
      "default": 1000,
      "description": "Configuration parameter: default_limit"
    },
    {
      "name": "default_window",
      "type": "number",
      "required": false,
      "default": 3600,
      "description": "Configuration parameter: default_window"
    },
    {
      "name": "burst_allowance",
      "type": "number",
      "required": false,
      "default": 10,
      "description": "Configuration parameter: burst_allowance"
    },
    {
      "name": "cleanup_interval",
      "type": "number",
      "required": false,
      "default": 300,
      "description": "Configuration parameter: cleanup_interval"
    }
  ],
  "outputs": [
    {
      "name": "result",
      "type": "json",
      "description": "Result"
    }
  ],
  "execution": {
    "type": "docker",
    "image": "ghcr.io/cerebrum-blocks/rate_limiter:latest"
  },
  "ui_schema": [
    {
      "name": "input",
      "widget": "json",
      "label": "JSON payload for the selected action"
    },
    {
      "name": "action",
      "widget": "select",
      "label": "Action",
      "options": [
        "check_limit",
        "record_hit",
        "set_custom_limit",
        "get_usage_stats",
        "reset_limit",
        "get_limit_info"
      ]
    },
    {
      "name": "strategy",
      "widget": "text",
      "label": "Strategy"
    },
    {
      "name": "default_limit",
      "widget": "number",
      "label": "Default Limit"
    },
    {
      "name": "default_window",
      "widget": "number",
      "label": "Default Window"
    },
    {
      "name": "burst_allowance",
      "widget": "number",
      "label": "Burst Allowance"
    },
    {
      "name": "cleanup_interval",
      "widget": "number",
      "label": "Cleanup Interval"
    }
  ],
  "tags": [
    "security",
    "protection",
    "infra",
    "rate_limiting"
  ]
}
