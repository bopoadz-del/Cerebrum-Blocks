{
  "id": "health_check",
  "name": "Health Check",
  "version": "1.0.0",
  "author": "Cerebrum Team",
  "description": "",
  "layer": 1,
  "requires": [
    "database",
    "memory",
    "config"
  ],
  "inputs": [
    {
      "name": "input",
      "type": "json",
      "required": false,
      "description": "JSON payload for the selected action"
    },
    {
      "name": "action",
      "type": "string",
      "required": false,
      "description": "Action",
      "default": "ping",
      "options": [
        "ping",
        "deep_check",
        "check_dependency",
        "register_probe",
        "unregister_probe",
        "get_status",
        "get_history",
        "simulate_failure"
      ]
    },
    {
      "name": "check_interval",
      "type": "number",
      "required": false,
      "default": 30,
      "description": "Configuration parameter: check_interval"
    },
    {
      "name": "deep_check_interval",
      "type": "number",
      "required": false,
      "default": 300,
      "description": "Configuration parameter: deep_check_interval"
    },
    {
      "name": "timeout_per_check",
      "type": "number",
      "required": false,
      "default": 5,
      "description": "Configuration parameter: timeout_per_check"
    },
    {
      "name": "alert_on_failure",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Configuration parameter: alert_on_failure"
    },
    {
      "name": "max_probe_history",
      "type": "number",
      "required": false,
      "default": 100,
      "description": "Configuration parameter: max_probe_history"
    }
  ],
  "outputs": [
    {
      "name": "status",
      "type": "text",
      "description": "Health status"
    }
  ],
  "execution": {
    "type": "docker",
    "image": "ghcr.io/cerebrum-blocks/health_check:latest"
  },
  "ui_schema": [
    {
      "name": "input",
      "widget": "json",
      "label": "JSON payload for the selected action"
    },
    {
      "name": "action",
      "widget": "select",
      "label": "Action",
      "options": [
        "ping",
        "deep_check",
        "check_dependency",
        "register_probe",
        "unregister_probe",
        "get_status",
        "get_history",
        "simulate_failure"
      ]
    },
    {
      "name": "check_interval",
      "widget": "number",
      "label": "Check Interval"
    },
    {
      "name": "deep_check_interval",
      "widget": "number",
      "label": "Deep Check Interval"
    },
    {
      "name": "timeout_per_check",
      "widget": "number",
      "label": "Timeout Per Check"
    },
    {
      "name": "alert_on_failure",
      "widget": "toggle",
      "label": "Alert On Failure"
    },
    {
      "name": "max_probe_history",
      "widget": "number",
      "label": "Max Probe History"
    }
  ],
  "tags": [
    "observability",
    "infra",
    "reliability",
    "health"
  ]
}
