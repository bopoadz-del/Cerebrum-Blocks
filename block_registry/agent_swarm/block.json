{
  "id": "agent_swarm",
  "name": "Agent Swarm",
  "version": "1.0.0",
  "author": "",
  "description": "Multi-agent task orchestration with dependency resolution and LLM routing",
  "inputs": [
    {
      "name": "input",
      "type": "json",
      "required": false,
      "description": "{\"objective\": \"Write a FastAPI endpoint\", \"agents\": [...], \"tasks\": [...]}"
    },
    {
      "name": "llm_provider",
      "type": "string",
      "required": false,
      "default": "ollama",
      "description": "Configuration parameter: llm_provider"
    },
    {
      "name": "ollama_base_url",
      "type": "string",
      "required": false,
      "default": "http://localhost:11434",
      "description": "Configuration parameter: ollama_base_url"
    },
    {
      "name": "ollama_model",
      "type": "string",
      "required": false,
      "default": "llama3.2:3b",
      "description": "Configuration parameter: ollama_model"
    },
    {
      "name": "deepseek_api_key",
      "type": "string",
      "required": false,
      "default": "",
      "description": "Configuration parameter: deepseek_api_key"
    },
    {
      "name": "deepseek_model",
      "type": "string",
      "required": false,
      "default": "deepseek-chat",
      "description": "Configuration parameter: deepseek_model"
    },
    {
      "name": "openrouter_api_key",
      "type": "string",
      "required": false,
      "default": "",
      "description": "Configuration parameter: openrouter_api_key"
    },
    {
      "name": "openrouter_model",
      "type": "string",
      "required": false,
      "default": "anthropic/claude-3.5-sonnet",
      "description": "Configuration parameter: openrouter_model"
    },
    {
      "name": "anthropic_api_key",
      "type": "string",
      "required": false,
      "default": "",
      "description": "Configuration parameter: anthropic_api_key"
    },
    {
      "name": "anthropic_model",
      "type": "string",
      "required": false,
      "default": "claude-sonnet-4-6",
      "description": "Configuration parameter: anthropic_model"
    },
    {
      "name": "vector_db_url",
      "type": "string",
      "required": false,
      "default": "http://localhost:8001",
      "description": "Configuration parameter: vector_db_url"
    },
    {
      "name": "max_concurrent_agents",
      "type": "number",
      "required": false,
      "default": 5,
      "description": "Configuration parameter: max_concurrent_agents"
    },
    {
      "name": "default_timeout",
      "type": "number",
      "required": false,
      "default": 120,
      "description": "Configuration parameter: default_timeout"
    },
    {
      "name": "store_memory",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Configuration parameter: store_memory"
    }
  ],
  "outputs": [
    {
      "name": "project_id",
      "type": "text",
      "description": "Project ID"
    },
    {
      "name": "status",
      "type": "text",
      "description": "Status"
    },
    {
      "name": "final_output",
      "type": "text",
      "description": "Final Output"
    },
    {
      "name": "outputs",
      "type": "json",
      "description": "Agent Outputs"
    },
    {
      "name": "total_tokens",
      "type": "number",
      "description": "Total Tokens"
    },
    {
      "name": "total_time_ms",
      "type": "number",
      "description": "Time (ms)"
    }
  ],
  "execution": {
    "type": "docker",
    "image": "ghcr.io/cerebrum-blocks/agent_swarm:latest"
  },
  "ui_schema": [
    {
      "name": "input",
      "widget": "json",
      "label": "{\"objective\": \"Write a FastAPI endpoint\", \"agents\": [...], \"tasks\": [...]}"
    },
    {
      "name": "llm_provider",
      "widget": "text",
      "label": "Llm Provider"
    },
    {
      "name": "ollama_base_url",
      "widget": "text",
      "label": "Ollama Base Url"
    },
    {
      "name": "ollama_model",
      "widget": "text",
      "label": "Ollama Model"
    },
    {
      "name": "deepseek_api_key",
      "widget": "text",
      "label": "Deepseek Api Key"
    },
    {
      "name": "deepseek_model",
      "widget": "text",
      "label": "Deepseek Model"
    },
    {
      "name": "openrouter_api_key",
      "widget": "text",
      "label": "Openrouter Api Key"
    },
    {
      "name": "openrouter_model",
      "widget": "text",
      "label": "Openrouter Model"
    },
    {
      "name": "anthropic_api_key",
      "widget": "text",
      "label": "Anthropic Api Key"
    },
    {
      "name": "anthropic_model",
      "widget": "text",
      "label": "Anthropic Model"
    },
    {
      "name": "vector_db_url",
      "widget": "text",
      "label": "Vector Db Url"
    },
    {
      "name": "max_concurrent_agents",
      "widget": "number",
      "label": "Max Concurrent Agents"
    },
    {
      "name": "default_timeout",
      "widget": "number",
      "label": "Default Timeout"
    },
    {
      "name": "store_memory",
      "widget": "toggle",
      "label": "Store Memory"
    }
  ],
  "tags": [
    "agents",
    "swarm",
    "orchestration",
    "ai",
    "multi-agent"
  ]
}