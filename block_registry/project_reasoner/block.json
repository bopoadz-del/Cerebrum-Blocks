{
  "id": "project_reasoner",
  "name": "Project Reasoner",
  "version": "1.0.0",
  "description": "LLM agent for project planning and reasoning.",
  "permissions": {
    "network": true,
    "filesystem": true,
    "imports": [
      "httpx",
      "json",
      "logging",
      "os"
    ],
    "blocks": []
  },
  "inputs": [
    {
      "name": "input",
      "type": "json",
      "required": false,
      "description": "Payload for project_reasoner"
    }
  ],
  "outputs": [
    {
      "name": "result",
      "type": "json",
      "description": "Result for project_reasoner"
    }
  ],
  "execution": {
    "type": "docker",
    "image": "ghcr.io/cerebrum-blocks/project_reasoner:latest"
  },
  "ui_schema": [
    {
      "name": "input",
      "label": "Payload for project_reasoner",
      "widget": "json"
    }
  ]
}
