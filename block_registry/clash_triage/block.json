{
  "id": "clash_triage",
  "name": "Clash Triage",
  "version": "1.0.0",
  "description": "Ranks clash findings into a build order: resolution rank, zone congestion, workflow-noise filtering, programme CSV loading.",
  "author": "Cerebrum Team",
  "tags": [
    "mep",
    "construction",
    "coordination"
  ],
  "trust_tier": "platform",
  "layer": 3,
  "inputs": [
    {
      "name": "action",
      "type": "string",
      "required": false,
      "options": [
        "triage",
        "rank",
        "congestion",
        "order",
        "programme",
        "clash_id"
      ],
      "description": "triage | rank | congestion | order | programme | clash_id"
    }
  ],
  "outputs": [
    {
      "name": "result",
      "type": "json",
      "description": "Capability result"
    }
  ],
  "permissions": {
    "network": false,
    "filesystem": true,
    "imports": [],
    "blocks": []
  },
  "requires": [],
  "never": [],
  "acceptance": [
    {
      "check": "stable clash id",
      "id": "clash_id",
      "status": "ok"
    },
    {
      "check": "unknown action returns an error envelope",
      "id": "unknown_action",
      "status": "error"
    }
  ],
  "publisher_id": "cerebrum_platform",
  "signature": "",
  "reads": [
    {
      "kind": "caller",
      "scope": "input"
    },
    {
      "kind": "file",
      "scope": "local.read"
    }
  ],
  "writes": [
    {
      "kind": "caller",
      "scope": "output"
    },
    {
      "kind": "file",
      "scope": "local.write"
    }
  ],
  "digests": {
    "block.py": "d2365d4f34fd501a7abe5a7ecedc85879aae145b9ac42ef734ec6534ac8e0c1d",
    "block.json": "7a14318842b08ce886510dcadac5174eead2d94998db7900e04b90b35444527d"
  }
}
