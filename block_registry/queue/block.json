{
  "id": "queue",
  "name": "Queue",
  "version": "1.0.0",
  "author": "Cerebrum Team",
  "description": "",
  "layer": 2,
  "requires": [
    "config",
    "memory"
  ],
  "inputs": [
    {
      "name": "input",
      "type": "json",
      "required": false,
      "description": "Job type, payload, queue name"
    },
    {
      "name": "action",
      "type": "string",
      "required": false,
      "description": "Action",
      "default": "enqueue",
      "options": [
        "enqueue",
        "dequeue",
        "status",
        "list"
      ]
    },
    {
      "name": "backend",
      "type": "string",
      "required": false,
      "description": "Backend",
      "default": "memory"
    },
    {
      "name": "redis_url",
      "type": "string",
      "required": false,
      "description": "Redis Url",
      "default": null
    },
    {
      "name": "max_workers",
      "type": "number",
      "required": false,
      "description": "Max Workers",
      "default": 4
    }
  ],
  "outputs": [
    {
      "name": "result",
      "type": "json",
      "description": "Result"
    }
  ],
  "execution": {
    "type": "docker",
    "image": "ghcr.io/cerebrum-blocks/queue:latest"
  },
  "ui_schema": [
    {
      "name": "input",
      "widget": "json",
      "label": "Job type, payload, queue name"
    },
    {
      "name": "action",
      "widget": "select",
      "label": "Action",
      "options": [
        "enqueue",
        "dequeue",
        "status",
        "list"
      ]
    },
    {
      "name": "backend",
      "widget": "text",
      "label": "Backend"
    },
    {
      "name": "redis_url",
      "widget": "text",
      "label": "Redis Url"
    },
    {
      "name": "max_workers",
      "widget": "number",
      "label": "Max Workers"
    }
  ],
  "tags": [
    "queue",
    "jobs",
    "async",
    "core"
  ]
}
