{
  "id": "billing",
  "name": "Billing",
  "version": "1.0.0",
  "author": "Cerebrum Team",
  "description": "",
  "layer": 5,
  "requires": [
    "config",
    "auth",
    "memory"
  ],
  "inputs": [
    {
      "name": "input",
      "type": "json",
      "required": false,
      "description": "JSON payload for the selected action"
    },
    {
      "name": "action",
      "type": "string",
      "required": false,
      "description": "Action",
      "default": "record_usage",
      "options": [
        "record_usage",
        "check_quota",
        "create_customer",
        "create_subscription",
        "get_invoice",
        "upgrade",
        "webhook"
      ]
    },
    {
      "name": "stripe_key",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Configuration parameter: stripe_key"
    },
    {
      "name": "free_tier_requests",
      "type": "number",
      "required": false,
      "default": 1000,
      "description": "Configuration parameter: free_tier_requests"
    },
    {
      "name": "pro_tier_requests",
      "type": "number",
      "required": false,
      "default": 50000,
      "description": "Configuration parameter: pro_tier_requests"
    }
  ],
  "outputs": [
    {
      "name": "result",
      "type": "json",
      "description": "Result"
    }
  ],
  "execution": {
    "type": "docker",
    "image": "ghcr.io/cerebrum-blocks/billing:latest"
  },
  "ui_schema": [
    {
      "name": "input",
      "widget": "json",
      "label": "JSON payload for the selected action"
    },
    {
      "name": "action",
      "widget": "select",
      "label": "Action",
      "options": [
        "record_usage",
        "check_quota",
        "create_customer",
        "create_subscription",
        "get_invoice",
        "upgrade",
        "webhook"
      ]
    },
    {
      "name": "stripe_key",
      "widget": "text",
      "label": "Stripe Key"
    },
    {
      "name": "free_tier_requests",
      "widget": "number",
      "label": "Free Tier Requests"
    },
    {
      "name": "pro_tier_requests",
      "widget": "number",
      "label": "Pro Tier Requests"
    }
  ],
  "tags": [
    "billing",
    "usage",
    "integration"
  ]
}
