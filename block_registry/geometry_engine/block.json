{
  "id": "geometry_engine",
  "name": "Geometry Engine",
  "version": "1.0.0",
  "description": "Exact clash and clearance measurement from one pass over IFC meshes: AABB pre-filter, then triangle-mesh judgement (CLASH vs CLEARANCE).",
  "author": "Cerebrum Team",
  "tags": [
    "mep",
    "construction",
    "coordination"
  ],
  "trust_tier": "platform",
  "layer": 3,
  "inputs": [
    {
      "name": "action",
      "type": "string",
      "required": false,
      "options": [
        "judge",
        "aabb_overlaps",
        "backend"
      ],
      "description": "judge | aabb_overlaps | backend"
    }
  ],
  "outputs": [
    {
      "name": "result",
      "type": "json",
      "description": "Capability result"
    }
  ],
  "permissions": {
    "network": false,
    "filesystem": true,
    "imports": [],
    "blocks": []
  },
  "requires": [],
  "never": [],
  "acceptance": [
    {
      "check": "identical boxes overlap",
      "id": "aabb_overlaps",
      "status": "ok"
    },
    {
      "check": "unknown action returns an error envelope",
      "id": "unknown_action",
      "status": "error"
    }
  ],
  "publisher_id": "cerebrum_platform",
  "signature": "",
  "reads": [
    {
      "kind": "caller",
      "scope": "input"
    },
    {
      "kind": "file",
      "scope": "local.read"
    }
  ],
  "writes": [
    {
      "kind": "caller",
      "scope": "output"
    },
    {
      "kind": "file",
      "scope": "local.write"
    }
  ],
  "digests": {
    "block.py": "f27033a17b8c4d4abc306ce39114b6ce82f08de4875c16a3533c444166d5e743",
    "block.json": "6baee3f0ffd92066f095d5563278fc0fccae8adede6c8023070bf9946bedc922"
  }
}
