{
  "id": "database",
  "name": "Database",
  "version": "1.0.0",
  "author": "Cerebrum Team",
  "description": "",
  "layer": 0,
  "requires": [
    "config"
  ],
  "inputs": [
    {
      "name": "input",
      "type": "json",
      "required": false,
      "description": "JSON payload for the selected action"
    },
    {
      "name": "action",
      "type": "string",
      "required": false,
      "description": "Action",
      "default": "query",
      "options": [
        "query",
        "insert",
        "update",
        "delete",
        "create_table",
        "list_tables"
      ]
    },
    {
      "name": "backend",
      "type": "string",
      "required": false,
      "default": "sqlite",
      "description": "Configuration parameter: backend"
    },
    {
      "name": "connection_string",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Configuration parameter: connection_string"
    }
  ],
  "outputs": [
    {
      "name": "rows",
      "type": "json",
      "description": "Rows"
    }
  ],
  "execution": {
    "type": "docker",
    "image": "ghcr.io/cerebrum-blocks/database:latest"
  },
  "ui_schema": [
    {
      "name": "input",
      "widget": "json",
      "label": "JSON payload for the selected action"
    },
    {
      "name": "action",
      "widget": "select",
      "label": "Action",
      "options": [
        "query",
        "insert",
        "update",
        "delete",
        "create_table",
        "list_tables"
      ]
    },
    {
      "name": "backend",
      "widget": "text",
      "label": "Backend"
    },
    {
      "name": "connection_string",
      "widget": "text",
      "label": "Connection String"
    }
  ],
  "tags": [
    "infrastructure",
    "database",
    "storage"
  ]
}
