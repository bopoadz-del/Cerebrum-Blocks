{
  "id": "team",
  "name": "Team",
  "version": "1.0.0",
  "author": "Cerebrum Team",
  "description": "",
  "layer": 3,
  "requires": [
    "auth",
    "database",
    "billing"
  ],
  "inputs": [
    {
      "name": "input",
      "type": "json",
      "required": false,
      "description": "JSON payload for the selected action"
    },
    {
      "name": "action",
      "type": "string",
      "required": false,
      "description": "Action",
      "default": "create_team",
      "options": [
        "create_team",
        "delete_team",
        "invite_member",
        "accept_invitation",
        "remove_member",
        "set_role",
        "get_team",
        "list_teams",
        "get_members",
        "get_team_context",
        "switch_team",
        "check_permission"
      ]
    },
    {
      "name": "max_members_per_team",
      "type": "number",
      "required": false,
      "default": 50,
      "description": "Configuration parameter: max_members_per_team"
    },
    {
      "name": "max_teams_per_org",
      "type": "number",
      "required": false,
      "default": 10,
      "description": "Configuration parameter: max_teams_per_org"
    },
    {
      "name": "default_role",
      "type": "string",
      "required": false,
      "default": "member",
      "description": "Configuration parameter: default_role"
    },
    {
      "name": "invitation_expiry_hours",
      "type": "number",
      "required": false,
      "default": 48,
      "description": "Configuration parameter: invitation_expiry_hours"
    },
    {
      "name": "enable_sso",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Configuration parameter: enable_sso"
    },
    {
      "name": "require_2fa_for_admins",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Configuration parameter: require_2fa_for_admins"
    }
  ],
  "outputs": [
    {
      "name": "result",
      "type": "json",
      "description": "Result"
    }
  ],
  "execution": {
    "type": "docker",
    "image": "ghcr.io/cerebrum-blocks/team:latest"
  },
  "ui_schema": [
    {
      "name": "input",
      "widget": "json",
      "label": "JSON payload for the selected action"
    },
    {
      "name": "action",
      "widget": "select",
      "label": "Action",
      "options": [
        "create_team",
        "delete_team",
        "invite_member",
        "accept_invitation",
        "remove_member",
        "set_role",
        "get_team",
        "list_teams",
        "get_members",
        "get_team_context",
        "switch_team",
        "check_permission"
      ]
    },
    {
      "name": "max_members_per_team",
      "widget": "number",
      "label": "Max Members Per Team"
    },
    {
      "name": "max_teams_per_org",
      "widget": "number",
      "label": "Max Teams Per Org"
    },
    {
      "name": "default_role",
      "widget": "text",
      "label": "Default Role"
    },
    {
      "name": "invitation_expiry_hours",
      "widget": "number",
      "label": "Invitation Expiry Hours"
    },
    {
      "name": "enable_sso",
      "widget": "toggle",
      "label": "Enable Sso"
    },
    {
      "name": "require_2fa_for_admins",
      "widget": "toggle",
      "label": "Require 2Fa For Admins"
    }
  ],
  "tags": [
    "platform",
    "multi-tenant",
    "enterprise",
    "collaboration"
  ]
}
