{
  "id": "construction",
  "name": "Construction Container",
  "version": "1.0.0",
  "description": "Construction domain container adapter.",
  "permissions": {
    "network": false,
    "filesystem": false,
    "imports": [],
    "blocks": []
  },
  "inputs": [
    {
      "name": "input",
      "type": "json",
      "required": false,
      "description": "Payload for construction"
    }
  ],
  "outputs": [
    {
      "name": "result",
      "type": "json",
      "description": "Result for construction"
    }
  ],
  "execution": {
    "type": "docker",
    "image": "ghcr.io/cerebrum-blocks/construction:latest"
  },
  "ui_schema": [
    {
      "name": "input",
      "label": "Payload for construction",
      "widget": "json"
    }
  ]
}
