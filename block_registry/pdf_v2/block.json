{
  "id": "pdf_v2",
  "name": "Pdf V2",
  "version": "2.0",
  "author": "",
  "description": "Extract text from PDF files with typed output",
  "inputs": [
    {
      "name": "input",
      "type": "file",
      "required": false,
      "description": "Upload PDF..."
    },
    {
      "name": "extract_tables",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Configuration parameter: extract_tables"
    },
    {
      "name": "max_pages",
      "type": "number",
      "required": false,
      "default": 100,
      "description": "Configuration parameter: max_pages"
    },
    {
      "name": "text_limit",
      "type": "number",
      "required": false,
      "default": 20000,
      "description": "Configuration parameter: text_limit"
    }
  ],
  "outputs": [
    {
      "name": "text",
      "type": "text",
      "description": "Text"
    },
    {
      "name": "pages",
      "type": "number",
      "description": "Pages"
    },
    {
      "name": "source",
      "type": "string",
      "description": "Source"
    }
  ],
  "execution": {
    "type": "docker",
    "image": "ghcr.io/cerebrum-blocks/pdf_v2:latest"
  },
  "ui_schema": [
    {
      "name": "input",
      "widget": "file",
      "label": "Upload PDF..."
    },
    {
      "name": "extract_tables",
      "widget": "toggle",
      "label": "Extract Tables"
    },
    {
      "name": "max_pages",
      "widget": "number",
      "label": "Max Pages"
    },
    {
      "name": "text_limit",
      "widget": "number",
      "label": "Text Limit"
    }
  ],
  "tags": [
    "domain",
    "documents",
    "pdf",
    "v2"
  ]
}