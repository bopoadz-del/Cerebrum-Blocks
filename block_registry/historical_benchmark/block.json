{
  "id": "historical_benchmark",
  "name": "Historical Benchmark",
  "version": "1.1",
  "author": "Cerebrum Team",
  "description": "RS Means-style benchmark unit costs, cost ranges, and market data for construction items",
  "layer": 2,
  "requires": [],
  "inputs": [
    {
      "name": "input",
      "type": "json",
      "required": false,
      "description": "Item description, unit, location, project type"
    },
    {
      "name": "item",
      "type": "string",
      "required": false,
      "description": "Item description",
      "default": ""
    },
    {
      "name": "unit",
      "type": "string",
      "required": false,
      "description": "Unit (m2, m3, kg, ea\u2026)",
      "default": ""
    },
    {
      "name": "location",
      "type": "string",
      "required": false,
      "description": "Location / city",
      "default": ""
    },
    {
      "name": "project_type",
      "type": "string",
      "required": false,
      "description": "Project type",
      "default": ""
    },
    {
      "name": "rates_env",
      "type": "string",
      "required": false,
      "default": "BENCHMARK_RATES_PATH",
      "description": "Configuration parameter: rates_env"
    },
    {
      "name": "factors_env",
      "type": "string",
      "required": false,
      "default": "BENCHMARK_FACTORS_PATH",
      "description": "Configuration parameter: factors_env"
    },
    {
      "name": "database_url_env",
      "type": "string",
      "required": false,
      "default": "DATABASE_URL",
      "description": "Configuration parameter: database_url_env"
    }
  ],
  "outputs": [
    {
      "name": "unit_cost",
      "type": "number",
      "description": "Unit cost"
    },
    {
      "name": "range",
      "type": "json",
      "description": "Cost range"
    },
    {
      "name": "location_factor",
      "type": "number",
      "description": "Location factor"
    }
  ],
  "execution": {
    "type": "docker",
    "image": "ghcr.io/cerebrum-blocks/historical_benchmark:latest"
  },
  "ui_schema": [
    {
      "name": "input",
      "widget": "json",
      "label": "Item description, unit, location, project type"
    },
    {
      "name": "item",
      "widget": "text",
      "label": "Item description"
    },
    {
      "name": "unit",
      "widget": "text",
      "label": "Unit (m2, m3, kg, ea\u2026)"
    },
    {
      "name": "location",
      "widget": "text",
      "label": "Location / city"
    },
    {
      "name": "project_type",
      "widget": "text",
      "label": "Project type"
    },
    {
      "name": "rates_env",
      "widget": "text",
      "label": "Rates Env"
    },
    {
      "name": "factors_env",
      "widget": "text",
      "label": "Factors Env"
    },
    {
      "name": "database_url_env",
      "widget": "text",
      "label": "Database Url Env"
    }
  ],
  "tags": [
    "construction",
    "cost",
    "benchmark",
    "rsmeans",
    "aec"
  ]
}
