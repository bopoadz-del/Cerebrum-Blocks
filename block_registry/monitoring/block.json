{
  "id": "monitoring",
  "name": "Monitoring",
  "version": "1.0.0",
  "author": "Cerebrum Team",
  "description": "",
  "layer": 2,
  "requires": [
    "config",
    "memory"
  ],
  "inputs": [
    {
      "name": "input",
      "type": "json",
      "required": false,
      "description": "JSON payload for the selected action"
    },
    {
      "name": "action",
      "type": "string",
      "required": false,
      "description": "Action",
      "default": "record_call",
      "options": [
        "record_call",
        "leaderboard",
        "provider_status",
        "recommend",
        "health_report",
        "predictive_failover"
      ]
    },
    {
      "name": "track_providers",
      "type": "json",
      "required": false,
      "description": "Track Providers",
      "default": [
        "deepseek",
        "anthropic"
      ]
    },
    {
      "name": "window_size",
      "type": "number",
      "required": false,
      "description": "Window Size",
      "default": 100
    },
    {
      "name": "prediction_threshold",
      "type": "number",
      "required": false,
      "description": "Prediction Threshold",
      "default": 0.3
    }
  ],
  "outputs": [
    {
      "name": "result",
      "type": "json",
      "description": "Result"
    }
  ],
  "execution": {
    "type": "docker",
    "image": "ghcr.io/cerebrum-blocks/monitoring:latest"
  },
  "ui_schema": [
    {
      "name": "input",
      "widget": "json",
      "label": "JSON payload for the selected action"
    },
    {
      "name": "action",
      "widget": "select",
      "label": "Action",
      "options": [
        "record_call",
        "leaderboard",
        "provider_status",
        "recommend",
        "health_report",
        "predictive_failover"
      ]
    },
    {
      "name": "track_providers",
      "widget": "json",
      "label": "Track Providers"
    },
    {
      "name": "window_size",
      "widget": "number",
      "label": "Window Size"
    },
    {
      "name": "prediction_threshold",
      "widget": "number",
      "label": "Prediction Threshold"
    }
  ],
  "tags": [
    "monitoring",
    "observability",
    "core"
  ]
}
