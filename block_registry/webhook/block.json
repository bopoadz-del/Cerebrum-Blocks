{
  "id": "webhook",
  "name": "Webhook",
  "version": "1.0.0",
  "author": "Cerebrum Team",
  "description": "",
  "layer": 5,
  "requires": [
    "config",
    "queue"
  ],
  "inputs": [
    {
      "name": "input",
      "type": "json",
      "required": false,
      "description": "Webhook URL, events, payload"
    },
    {
      "name": "action",
      "type": "string",
      "required": false,
      "description": "Action",
      "default": "register",
      "options": [
        "register",
        "send",
        "trigger",
        "list"
      ]
    },
    {
      "name": "timeout",
      "type": "number",
      "required": false,
      "description": "Timeout",
      "default": 30
    },
    {
      "name": "retries",
      "type": "number",
      "required": false,
      "description": "Retries",
      "default": 3
    },
    {
      "name": "verify_ssl",
      "type": "boolean",
      "required": false,
      "description": "Verify Ssl",
      "default": true
    }
  ],
  "outputs": [
    {
      "name": "result",
      "type": "json",
      "description": "Result"
    }
  ],
  "execution": {
    "type": "docker",
    "image": "ghcr.io/cerebrum-blocks/webhook:latest"
  },
  "ui_schema": [
    {
      "name": "input",
      "widget": "json",
      "label": "Webhook URL, events, payload"
    },
    {
      "name": "action",
      "widget": "select",
      "label": "Action",
      "options": [
        "register",
        "send",
        "trigger",
        "list"
      ]
    },
    {
      "name": "timeout",
      "widget": "number",
      "label": "Timeout"
    },
    {
      "name": "retries",
      "widget": "number",
      "label": "Retries"
    },
    {
      "name": "verify_ssl",
      "widget": "toggle",
      "label": "Verify Ssl"
    }
  ],
  "tags": [
    "webhook",
    "http",
    "integration"
  ]
}
