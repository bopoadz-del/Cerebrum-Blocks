{
  "id": "storage",
  "name": "Storage",
  "version": "1.0.0",
  "author": "Cerebrum Team",
  "description": "",
  "layer": 2,
  "requires": [
    "config"
  ],
  "inputs": [
    {
      "name": "input",
      "type": "json",
      "required": false,
      "description": "JSON payload for the selected action"
    },
    {
      "name": "action",
      "type": "string",
      "required": false,
      "description": "Action",
      "default": "store",
      "options": [
        "store",
        "retrieve",
        "delete",
        "exists",
        "list"
      ]
    },
    {
      "name": "backend",
      "type": "string",
      "required": false,
      "default": "local",
      "description": "Configuration parameter: backend"
    },
    {
      "name": "data_dir",
      "type": "string",
      "required": false,
      "default": "./data/storage",
      "description": "Configuration parameter: data_dir"
    }
  ],
  "outputs": [
    {
      "name": "result",
      "type": "json",
      "description": "Result"
    }
  ],
  "execution": {
    "type": "docker",
    "image": "ghcr.io/cerebrum-blocks/storage:latest"
  },
  "ui_schema": [
    {
      "name": "input",
      "widget": "json",
      "label": "JSON payload for the selected action"
    },
    {
      "name": "action",
      "widget": "select",
      "label": "Action",
      "options": [
        "store",
        "retrieve",
        "delete",
        "exists",
        "list"
      ]
    },
    {
      "name": "backend",
      "widget": "text",
      "label": "Backend"
    },
    {
      "name": "data_dir",
      "widget": "text",
      "label": "Data Dir"
    }
  ],
  "tags": [
    "storage",
    "files",
    "core"
  ]
}
