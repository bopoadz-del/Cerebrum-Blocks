{
  "id": "workflow",
  "name": "Workflow",
  "version": "1.0.0",
  "author": "Cerebrum Team",
  "description": "Chain blocks into pipelines with variable interpolation and scheduling",
  "layer": 2,
  "requires": [],
  "inputs": [
    {
      "name": "input",
      "type": "json",
      "required": false,
      "description": "{\"pipeline_id\": \"daily-report\", \"steps\": [...]}"
    },
    {
      "name": "action",
      "type": "string",
      "required": false,
      "description": "Action",
      "default": "run",
      "options": [
        "run",
        "schedule",
        "unschedule",
        "list",
        "get",
        "history",
        "status",
        "health"
      ]
    },
    {
      "name": "max_pipeline_steps",
      "type": "number",
      "required": false,
      "description": "Max Pipeline Steps",
      "default": 20
    },
    {
      "name": "enable_scheduler",
      "type": "boolean",
      "required": false,
      "description": "Enable Scheduler",
      "default": true
    },
    {
      "name": "default_timeout",
      "type": "number",
      "required": false,
      "description": "Default Timeout",
      "default": 60
    }
  ],
  "outputs": [
    {
      "name": "pipeline_id",
      "type": "text",
      "description": "Pipeline ID"
    },
    {
      "name": "status",
      "type": "text",
      "description": "Status"
    },
    {
      "name": "results",
      "type": "json",
      "description": "Step Results"
    },
    {
      "name": "execution_time_ms",
      "type": "number",
      "description": "Time (ms)"
    }
  ],
  "execution": {
    "type": "docker",
    "image": "ghcr.io/cerebrum-blocks/workflow:latest"
  },
  "ui_schema": [
    {
      "name": "input",
      "widget": "json",
      "label": "{\"pipeline_id\": \"daily-report\", \"steps\": [...]}"
    },
    {
      "name": "action",
      "widget": "select",
      "label": "Action",
      "options": [
        "run",
        "schedule",
        "unschedule",
        "list",
        "get",
        "history",
        "status",
        "health"
      ]
    },
    {
      "name": "max_pipeline_steps",
      "widget": "number",
      "label": "Max Pipeline Steps"
    },
    {
      "name": "enable_scheduler",
      "widget": "toggle",
      "label": "Enable Scheduler"
    },
    {
      "name": "default_timeout",
      "widget": "number",
      "label": "Default Timeout"
    }
  ],
  "tags": [
    "workflow",
    "pipeline",
    "orchestration",
    "automation",
    "core"
  ]
}