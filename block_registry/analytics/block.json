{
  "id": "analytics",
  "name": "Analytics",
  "version": "1.0.0",
  "author": "Cerebrum Team",
  "description": "",
  "layer": 2,
  "requires": [
    "database",
    "monitoring"
  ],
  "inputs": [
    {
      "name": "input",
      "type": "json",
      "required": false,
      "description": "JSON payload for the selected action"
    },
    {
      "name": "action",
      "type": "string",
      "required": false,
      "description": "Action",
      "default": "track_event",
      "options": [
        "track_event",
        "leaderboard",
        "usage_report",
        "predict_failure",
        "cost_analysis",
        "get_metrics",
        "compare_providers"
      ]
    },
    {
      "name": "window_size",
      "type": "number",
      "required": false,
      "description": "Window Size",
      "default": 100
    },
    {
      "name": "prediction_threshold",
      "type": "number",
      "required": false,
      "description": "Prediction Threshold",
      "default": 0.3
    },
    {
      "name": "retention_hours",
      "type": "number",
      "required": false,
      "default": 168,
      "description": "Configuration parameter: retention_hours"
    },
    {
      "name": "aggregation_interval",
      "type": "number",
      "required": false,
      "default": 300,
      "description": "Configuration parameter: aggregation_interval"
    },
    {
      "name": "prediction_window",
      "type": "number",
      "required": false,
      "default": 10,
      "description": "Configuration parameter: prediction_window"
    },
    {
      "name": "cost_per_1k_requests",
      "type": "json",
      "required": false,
      "default": {
        "deepseek": 0.14
      },
      "description": "Configuration parameter: cost_per_1k_requests"
    }
  ],
  "outputs": [
    {
      "name": "result",
      "type": "json",
      "description": "Result"
    }
  ],
  "execution": {
    "type": "docker",
    "image": "ghcr.io/cerebrum-blocks/analytics:latest"
  },
  "ui_schema": [
    {
      "name": "input",
      "widget": "json",
      "label": "JSON payload for the selected action"
    },
    {
      "name": "action",
      "widget": "select",
      "label": "Action",
      "options": [
        "track_event",
        "leaderboard",
        "usage_report",
        "predict_failure",
        "cost_analysis",
        "get_metrics",
        "compare_providers"
      ]
    },
    {
      "name": "window_size",
      "widget": "number",
      "label": "Window Size"
    },
    {
      "name": "prediction_threshold",
      "widget": "number",
      "label": "Prediction Threshold"
    },
    {
      "name": "retention_hours",
      "widget": "number",
      "label": "Retention Hours"
    },
    {
      "name": "aggregation_interval",
      "widget": "number",
      "label": "Aggregation Interval"
    },
    {
      "name": "prediction_window",
      "widget": "number",
      "label": "Prediction Window"
    },
    {
      "name": "cost_per_1k_requests",
      "widget": "json",
      "label": "Cost Per 1K Requests"
    }
  ],
  "tags": [
    "metrics",
    "reporting",
    "analytics",
    "platform"
  ]
}
