    {
      "name": "aggregation_interval",
      "widget": "number",
      "label": "Aggregation Interval"
    },
    {
      "name": "prediction_window",
      "widget": "number",
      "label": "Prediction Window"
    },
    {
      "name": "cost_per_1k_requests",
