      "description": "Configuration parameter: retention_hours"
    },
    {
      "name": "aggregation_interval",
      "type": "number",
      "required": false,
      "default": 300,
      "description": "Configuration parameter: aggregation_interval"
    },
    {
      "name": "prediction_window",
      "type": "number",
      "required": false,
