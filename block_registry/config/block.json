{
  "id": "config",
  "name": "Config",
  "version": "1.0.0",
  "author": "Cerebrum Team",
  "description": "",
  "layer": 0,
  "requires": [
    "hal"
  ],
  "inputs": [
    {
      "name": "input",
      "type": "json",
      "required": false,
      "description": "Config key/value payload"
    },
    {
      "name": "action",
      "type": "string",
      "required": false,
      "description": "Action",
      "default": "get",
      "options": [
        "get",
        "get_all",
        "set"
      ]
    },
    {
      "name": "config_file",
      "type": "string",
      "required": false,
      "default": "config/blocks.json",
      "description": "Configuration parameter: config_file"
    },
    {
      "name": "env_prefix",
      "type": "string",
      "required": false,
      "default": "CEREBRUM_",
      "description": "Configuration parameter: env_prefix"
    }
  ],
  "outputs": [
    {
      "name": "result",
      "type": "json",
      "description": "Result"
    }
  ],
  "execution": {
    "type": "docker",
    "image": "ghcr.io/cerebrum-blocks/config:latest"
  },
  "ui_schema": [
    {
      "name": "input",
      "widget": "json",
      "label": "Config key/value payload"
    },
    {
      "name": "action",
      "widget": "select",
      "label": "Action",
      "options": [
        "get",
        "get_all",
        "set"
      ]
    },
    {
      "name": "config_file",
      "widget": "text",
      "label": "Config File"
    },
    {
      "name": "env_prefix",
      "widget": "text",
      "label": "Env Prefix"
    }
  ],
  "tags": [
    "infrastructure",
    "core"
  ]
}
