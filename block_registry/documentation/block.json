{
  "id": "documentation",
  "name": "Documentation",
  "version": "1.0.0",
  "author": "Cerebrum Team",
  "description": "",
  "layer": 4,
  "requires": [
    "code",
    "vector"
  ],
  "inputs": [
    {
      "name": "input",
      "type": "json",
      "required": false,
      "description": "JSON payload for the selected action"
    },
    {
      "name": "action",
      "type": "string",
      "required": false,
      "description": "Action",
      "default": "generate_docs",
      "options": [
        "generate_docs",
        "extract_signature",
        "create_playground",
        "search_docs",
        "add_example",
        "get_examples",
        "render_markdown",
        "validate_docs"
      ]
    },
    {
      "name": "auto_generate",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Configuration parameter: auto_generate"
    },
    {
      "name": "include_playground",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Configuration parameter: include_playground"
    },
    {
      "name": "examples_per_block",
      "type": "number",
      "required": false,
      "default": 3,
      "description": "Configuration parameter: examples_per_block"
    },
    {
      "name": "doc_format",
      "type": "string",
      "required": false,
      "default": "markdown",
      "description": "Configuration parameter: doc_format"
    },
    {
      "name": "theme",
      "type": "string",
      "required": false,
      "default": "github",
      "description": "Configuration parameter: theme"
    }
  ],
  "outputs": [
    {
      "name": "result",
      "type": "json",
      "description": "Result"
    }
  ],
  "execution": {
    "type": "docker",
    "image": "ghcr.io/cerebrum-blocks/documentation:latest"
  },
  "ui_schema": [
    {
      "name": "input",
      "widget": "json",
      "label": "JSON payload for the selected action"
    },
    {
      "name": "action",
      "widget": "select",
      "label": "Action",
      "options": [
        "generate_docs",
        "extract_signature",
        "create_playground",
        "search_docs",
        "add_example",
        "get_examples",
        "render_markdown",
        "validate_docs"
      ]
    },
    {
      "name": "auto_generate",
      "widget": "toggle",
      "label": "Auto Generate"
    },
    {
      "name": "include_playground",
      "widget": "toggle",
      "label": "Include Playground"
    },
    {
      "name": "examples_per_block",
      "widget": "number",
      "label": "Examples Per Block"
    },
    {
      "name": "doc_format",
      "widget": "text",
      "label": "Doc Format"
    },
    {
      "name": "theme",
      "widget": "text",
      "label": "Theme"
    }
  ],
  "tags": [
    "platform",
    "docs",
    "developer",
    "developer_tools"
  ]
}
