{
  "id": "email",
  "name": "Email",
  "version": "1.0.0",
  "author": "Cerebrum Team",
  "description": "",
  "layer": 5,
  "requires": [
    "config"
  ],
  "inputs": [
    {
      "name": "input",
      "type": "json",
      "required": false,
      "description": "Recipient, subject, body, template data"
    },
    {
      "name": "action",
      "type": "string",
      "required": false,
      "description": "Action",
      "default": "send",
      "options": [
        "send",
        "send_template",
        "validate_address"
      ]
    },
    {
      "name": "provider",
      "type": "string",
      "required": false,
      "default": "smtp",
      "description": "Configuration parameter: provider"
    },
    {
      "name": "smtp_host",
      "type": "string",
      "required": false,
      "default": "localhost",
      "description": "Configuration parameter: smtp_host"
    },
    {
      "name": "smtp_port",
      "type": "number",
      "required": false,
      "default": 587,
      "description": "Configuration parameter: smtp_port"
    }
  ],
  "outputs": [
    {
      "name": "result",
      "type": "json",
      "description": "Result"
    }
  ],
  "execution": {
    "type": "docker",
    "image": "ghcr.io/cerebrum-blocks/email:latest"
  },
  "ui_schema": [
    {
      "name": "input",
      "widget": "json",
      "label": "Recipient, subject, body, template data"
    },
    {
      "name": "action",
      "widget": "select",
      "label": "Action",
      "options": [
        "send",
        "send_template",
        "validate_address"
      ]
    },
    {
      "name": "provider",
      "widget": "text",
      "label": "Provider"
    },
    {
      "name": "smtp_host",
      "widget": "text",
      "label": "Smtp Host"
    },
    {
      "name": "smtp_port",
      "widget": "number",
      "label": "Smtp Port"
    }
  ],
  "tags": [
    "email",
    "notification",
    "integration"
  ]
}
